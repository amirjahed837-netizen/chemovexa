# AI Chemistry Assistant — optional LLM generation
# Without these, the assistant runs in retrieval-only mode (BM25 over the
# site corpus) and still answers chemistry questions using the site's own
# engines (molar mass, balance, composition). Set these to enable grounded
# LLM generation with [n] citations.

# Any OpenAI-compatible API key. If unset, retrieval-only mode is used.
AI_API_KEY=

# Base URL of the OpenAI-compatible endpoint. Default: api.openai.com
# Use https://openrouter.ai/api/v1, https://api.deepseek.com/v1, etc.
AI_BASE_URL=https://api.openai.com/v1

# Model name passed to the /chat/completions endpoint. Default: gpt-4o-mini
AI_MODEL=gpt-4o-mini

# Public site URL — used for absolute URLs in sitemap.xml, robots.txt, and
# JSON-LD structured data. Set this to your production domain before
# deploying (Vercel: set in Project Settings → Environment Variables).
NEXT_PUBLIC_SITE_URL=https://chemovexa.vercel.app
